# Copy to backend/.env for local development:  cp .env.example .env
# In production (Render), set these in the dashboard instead — never commit a real .env.

# --- Required in production ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
# Your Render hostname is added automatically; add custom domains here.
ALLOWED_HOSTS=localhost,127.0.0.1
# Neon (or any Postgres) connection string. Leave unset locally to use SQLite.
# DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Frontend origin(s) allowed to call the API (comma-separated, no trailing slash).
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Optional: allow all Vercel preview URLs of your project, e.g.
# CORS_ALLOWED_ORIGIN_REGEX=^https://cyberguard-ai.*\.vercel\.app$
CSRF_TRUSTED_ORIGINS=

# --- Gemini (free key: https://aistudio.google.com/apikey) ---
# Without a key the app still works; AI explanations fall back to templates.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=25

# --- Optional tuning ---
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
THROTTLE_AI=20/min
THROTTLE_AUTH=10/min
LOG_LEVEL=INFO

# --- First admin user (created by build.sh if set) ---
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=you@example.com
# DJANGO_SUPERUSER_PASSWORD=a-strong-password
